# העתק לקובץ .env ומלא ערכים אמיתיים. אל תעלה את .env ל-GitHub.

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5-nano

# MySQL (תואם ל-docker-compose.yml)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=chat_root_pass
DB_NAME=chat_db

# JWT - מחרוזת אקראית וארוכה
JWT_SECRET=change-me-to-a-long-random-string

# כתובת ה-Frontend (ל-CORS)
FRONTEND_URL=http://localhost:5173
