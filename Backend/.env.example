# העתק לקובץ .env ומלא ערכים אמיתיים. אל תעלה את .env ל-GitHub.

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-6-luna
OPENAI_IMAGE_MODEL=gpt-image-1-mini

# MySQL (תואם ל-docker-compose.yml)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=chat_root_pass
DB_NAME=chat_db

# JWT - חובה למלא מחרוזת אקראית משלך (לפחות 32 תווים). השרת לא יעלה בלעדיה.
# ליצירה: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# כתובת ה-Frontend (ל-CORS)
FRONTEND_URL=http://localhost:5173
